---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import logo from '../assets/images/logo.jpg';

const currentYear = new Date().getFullYear();
---

<footer class="bg-ink text-ivory">
  <div class="h-px bg-gradient-to-r from-transparent via-burgundy/70 to-transparent"></div>

  <div class="section-padding !pb-12 !pt-14 md:!pt-16">
    <div class="container-wide">
      <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10">
        <div class="sm:col-span-2 lg:col-span-4">
          <a href="/" class="inline-flex items-center gap-3.5">
            <Image
              src={logo}
              alt={site.name}
              width={64}
              height={64}
              class="h-14 w-14 rounded-full object-cover ring-1 ring-ivory/15"
            />
            <div>
              <p class="font-serif text-2xl leading-none tracking-tight">Hélia Dias</p>
              <p class="mt-1 text-xs tracking-[0.18em] text-ivory/55 uppercase">
                {site.tagline}
              </p>
            </div>
          </a>
          <p class="mt-5 max-w-xs text-sm leading-relaxed text-ivory/70">
            Salão de cabeleireiro e estética em Esposende, com atendimento personalizado desde
            1990.
          </p>
          <p class="footer-label mt-6">Desde 1990 · Esposende</p>
        </div>

        <div class="lg:col-span-3">
          <p class="footer-label mb-4">Contactos</p>
          <ul class="space-y-4 text-sm">
            <li>
              <a
                href={site.links.googleMaps}
                target="_blank"
                rel="noopener noreferrer"
                class="group block transition-colors hover:text-ivory"
              >
                <span class="text-ivory/50">Morada</span>
                <span class="mt-0.5 block leading-relaxed text-ivory/85 group-hover:text-ivory">
                  {site.address.street}
                  <br />
                  {site.address.postalCode} {site.address.city}
                </span>
              </a>
            </li>
            <li>
              <a
                href={site.phoneHref}
                class="group block transition-colors hover:text-ivory"
              >
                <span class="text-ivory/50">Telefone</span>
                <span class="mt-0.5 block text-ivory/85 group-hover:text-ivory">{site.phone}</span>
              </a>
            </li>
            <li>
              <a
                href={`mailto:${site.email}`}
                class="group block transition-colors hover:text-ivory"
              >
                <span class="text-ivory/50">Email</span>
                <span class="mt-0.5 block text-ivory/85 group-hover:text-ivory">{site.email}</span>
              </a>
            </li>
          </ul>
        </div>

        <div class="lg:col-span-2">
          <p class="footer-label mb-4">Navegação</p>
          <nav aria-label="Rodapé">
            <ul class="space-y-2.5">
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="text-sm text-ivory/75 transition-colors hover:text-ivory"
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="lg:col-span-3">
          <p class="footer-label mb-4">Redes & avaliações</p>
          <ul class="space-y-2.5">
            <li>
              <a
                href={site.links.instagram}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-ivory/75 transition-colors hover:text-ivory"
              >
                <svg class="h-4 w-4 shrink-0 opacity-70" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
                </svg>
                Instagram
              </a>
            </li>
            <li>
              <a
                href={site.links.facebook}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-ivory/75 transition-colors hover:text-ivory"
              >
                <svg class="h-4 w-4 shrink-0 opacity-70" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"></path>
                </svg>
                Facebook
              </a>
            </li>
            <li>
              <a
                href={site.links.googleReviews}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 text-sm text-ivory/75 transition-colors hover:text-ivory"
              >
                <svg class="h-4 w-4 shrink-0 opacity-70" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
                  <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
                  <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path>
                  <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path>
                </svg>
                Avaliações Google
              </a>
            </li>
          </ul>

          <a
            href={site.links.livroReclamacoes}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-block opacity-85 transition-opacity hover:opacity-100"
            aria-label="Aceder ao Livro de Reclamações Eletrónico"
          >
            <img
              src="/livro-reclamacoes.png"
              alt="Livro de Reclamações Eletrónico"
              width="170"
              height="70"
              class="h-14 w-auto sm:h-16 md:h-[4.375rem]"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-ivory/10">
    <div
      class="container-wide flex flex-col gap-4 px-5 py-6 text-sm text-ivory/45 md:flex-row md:items-center md:justify-between md:px-8 lg:px-12"
    >
      <p>© {currentYear} {site.name}</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/politica-de-privacidade" class="transition-colors hover:text-ivory/70">
          Política de Privacidade
        </a>
        <a href="/termos-de-utilizacao" class="transition-colors hover:text-ivory/70">
          Termos de Utilização
        </a>
        <span class="text-ivory/30" aria-hidden="true">·</span>
        <span class="text-ivory/40">{site.location}</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-label {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(246 241 232 / 0.45);
  }
</style>
