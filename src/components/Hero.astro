---
import heroSalao from '../assets/images/hero-salao.jpg';
import { content, type Geral, type Hero } from '../lib/server/content.ts';
import { imageSizes } from '../lib/imageSizes';
import Button from './Button.astro';
import Img from './Img.astro';

const g = await content.get<Geral>('geral');
const h = await content.get<Hero>('hero');

const { sql } = await import('../lib/server/db.ts');
const [seedRow] = await sql<{ arquivo: string }[]>`select arquivo from imagens where alt = 'hero-salao.jpg' limit 1`;
/** Imagem trocada no painel (outro UUID que o do seed). */
const useUploadHero = Boolean(seedRow?.arquivo && h.imagem !== seedRow.arquivo);

const heroImgClass = 'hero-bg absolute inset-0 h-full w-full';
---

<section class="hero relative flex min-h-[70vh] items-end overflow-hidden md:min-h-[68vh]">
  <div class="absolute inset-0 bg-ink">
    {useUploadHero ? (
      <Img
        arquivo={h.imagem}
        alt={h.imagemAlt}
        class={heroImgClass}
        loading="eager"
        fetchpriority="high"
        sizes={imageSizes.hero}
      />
    ) : (
      <img
        src={heroSalao.src}
        width={heroSalao.width}
        height={heroSalao.height}
        alt={h.imagemAlt}
        class={heroImgClass}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )}
    <div
      class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/20 md:bg-gradient-to-r md:from-ink/85 md:via-ink/45 md:to-transparent"
    >
    </div>
  </div>

  <div class="relative w-full px-5 pb-14 pt-32 md:px-8 md:pb-20 lg:px-12 lg:pb-24">
    <div class="container-wide max-w-3xl">
      <p class="hero-kicker mb-4">{g.kicker}</p>
      <h1
        class="font-serif text-[2.65rem] leading-[1.02] tracking-tight text-ivory sm:text-5xl lg:text-[4.25rem]"
      >
        {h.titulo}<br />
        <span class="hero-accent">{h.destaque}</span>
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-ivory/85 md:text-lg">
        {h.texto}
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={g.whatsappHref} external>{h.botaoPrimario}</Button>
        <Button
          href="#servicos"
          variant="secondary"
          class="!border-ivory/30 !text-ivory hover:!border-ivory/50 hover:!bg-ivory/10"
        >
          {h.botaoSecundario}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-bg {
    object-fit: cover;
    object-position: center 30%;
  }

  @media (min-width: 768px) {
    .hero-bg {
      object-position: center 22%;
    }
  }

  @media (min-width: 1280px) {
    .hero-bg {
      object-fit: contain;
      object-position: center bottom;
    }
  }

  .hero-kicker {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(246 241 232 / 0.92);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.45);
  }

  .hero-accent {
    color: #f5dce0;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.55);
  }

  .hero :global(.btn-primary) {
    background: var(--color-ivory);
    color: var(--color-ink);
  }

  .hero :global(.btn-primary:hover) {
    background: var(--color-ivory-dark);
  }
</style>
