---
import { googleRating, reviews } from '../data/reviews';
import ReviewAvatar from './ReviewAvatar.astro';
import SectionHeading from './SectionHeading.astro';
---

<section class="section-padding bg-white/40">
  <div class="container-wide">
    <SectionHeading
      label="Quem nos visita"
      title="A melhor recomendação vem de quem já passou pelas nossas mãos."
      align="center"
      class="mx-auto text-center"
    />

    <div class="mt-10 flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-3">
      <div class="flex items-center gap-2 text-sm text-ink-muted">
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        <span>Avaliações publicadas no Google</span>
      </div>
      <span class="hidden text-ink/20 sm:inline" aria-hidden="true">·</span>
      <p class="text-sm font-medium text-ink">
        {googleRating.score.toFixed(1).replace('.', ',')}/5 · {googleRating.count} críticas
      </p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      {
        reviews.map((review) => (
          <article class="google-review flex h-full flex-col rounded-lg border border-ink/8 bg-ivory p-5 shadow-sm md:p-6">
            <div class="flex items-start gap-3">
              <ReviewAvatar author={review.author} avatar={review.avatar} />
              <div class="min-w-0 flex-1">
                <p class="truncate font-medium text-ink">{review.author}</p>
                <p class="text-xs text-ink-muted">{review.relativeTime}</p>
              </div>
            </div>

            <div
              class="mt-3 flex gap-0.5 text-amber-500"
              aria-label={`${review.rating} de 5 estrelas`}
            >
              {
                Array.from({ length: 5 }).map((_, i) => (
                  <span class={i < review.rating ? 'opacity-100' : 'opacity-25'}>★</span>
                ))
              }
            </div>

            <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-muted">{review.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .google-review {
    transition: box-shadow 0.2s ease;
  }

  .google-review:hover {
    box-shadow: 0 4px 24px rgb(28 22 20 / 6%);
  }
</style>
