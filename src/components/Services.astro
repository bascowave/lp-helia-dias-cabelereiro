---
import { serviceCategories } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---

<section id="servicos" class="section-padding">
  <div class="container-wide">
    <SectionHeading
      label="Os nossos serviços"
      title="Cuidados pensados para si"
      description="Do corte à cor, dos tratamentos aos momentos mais especiais, trabalhamos cada serviço de forma personalizada para valorizar a sua beleza e respeitar a identidade do seu cabelo."
    />

    <div class="mt-14 grid gap-px overflow-hidden rounded-sm border border-ink/8 bg-ink/8 lg:grid-cols-3">
      {
        serviceCategories.map((category, index) => (
          <article class="bg-ivory p-6 md:p-7">
            <p class="kicker mb-2">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="font-serif text-xl tracking-tight text-ink md:text-2xl">{category.title}</h3>
            <ul
              class:list={[
                'mt-3 text-sm leading-snug text-ink-muted',
                category.items.length > 5
                  ? 'columns-1 gap-x-6 sm:columns-2'
                  : 'space-y-1.5',
              ]}
            >
              {
                category.items.map((item) => (
                  <li class="break-inside-avoid py-0.5">{item}</li>
                ))
              }
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
