---
import { content, type Geral, type Galeria } from '../lib/server/content.ts';
import Img from './Img.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';

const g = await content.get<Geral>('geral');
const gl = await content.get<Galeria>('galeria');
---

<section id="galeria" class="section-padding">
  <div class="container-wide">
    <SectionHeading
      label={gl.label}
      title={gl.title}
      description={gl.description}
    />

    <div class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 md:gap-5">
      {
        gl.itens.map((item) => (
          <figure class="group aspect-[4/5] overflow-hidden rounded-sm bg-ivory-dark">
            <Img
              arquivo={item.image}
              alt={item.alt}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 300px"
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <Button href={g.instagram} external variant="secondary">
        {gl.botao}
      </Button>
    </div>
  </div>
</section>
