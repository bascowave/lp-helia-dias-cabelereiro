---
import { content, type Geral, type Sobre } from '../lib/server/content.ts';
import Img from './Img.astro';
const g = await content.get<Geral>('geral');
const a = await content.get<Sobre>('sobre');
---

<section id="sobre" class="section-padding bg-ivory-dark">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)] lg:items-center lg:gap-20">
      <div class="flex flex-col items-start">
        <Img
          arquivo={g.logo}
          alt={g.name}
          sizes="120px"
          class="h-24 w-24 rounded-full object-cover md:h-28 md:w-28"
        />
        <p class="kicker mt-8 mb-4">{a.label}</p>
        <h2 class="font-serif text-4xl leading-tight tracking-tight text-ink md:text-5xl">
          {a.titulo}
        </h2>
        <p class="mt-10 font-serif text-3xl italic text-ink md:text-4xl">{a.assinatura}</p>
      </div>

      <div class="space-y-5 text-base leading-relaxed text-ink-muted md:text-lg">
        {a.texto.split(/\n\s*\n/).map((p) => <p>{p.trim()}</p>)}

        <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-ink/10 pt-8">
          {
            a.numeros.map((n) => (
              <div>
                <dt class="font-serif text-3xl text-ink">{n.valor}</dt>
                <dd class="mt-1 text-sm text-ink-muted">{n.legenda}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
