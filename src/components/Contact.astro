---
import { content, type Geral, type Contactos } from '../lib/server/content.ts';
import Button from './Button.astro';

const g = await content.get<Geral>('geral');
const c = await content.get<Contactos>('contactos');
---

<section id="contactos" class="section-padding bg-ivory-dark">
  <div class="container-wide">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="kicker mb-4">{c.label}</p>
        <h2 class="font-serif text-4xl tracking-tight text-ink md:text-5xl">{c.titulo}</h2>
        <p class="mt-4 max-w-md text-base leading-relaxed text-ink-muted">
          {c.texto}
        </p>

        <div class="mt-10 space-y-6">
          <div>
            <p class="kicker mb-2">Morada</p>
            <p class="text-lg text-ink">{g.street}</p>
            <p class="text-lg text-ink">{g.city}</p>
          </div>

          <div>
            <p class="kicker mb-2">Telefone</p>
            <a href={g.phoneHref} class="text-lg text-ink transition-colors hover:text-burgundy">
              {g.phone}
            </a>
          </div>
        </div>

        <div class="mt-10">
          <Button href={g.whatsappHref} external>{c.botao}</Button>
        </div>
      </div>

      <div class="overflow-hidden rounded-sm border border-ink/10 bg-white shadow-sm">
        <iframe
          title="Localização Hélia Dias Cabeleireiros no Google Maps"
          src={g.mapsEmbed}
          width="100%"
          height="100%"
          class="min-h-[20rem] lg:min-h-full"
          style="border:0;"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>
