---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <Header />
  <main class="bg-ivory pt-28 pb-16 md:pt-32 md:pb-20">
    <article class="container-narrow legal-content px-5 md:px-8">
      <slot />
    </article>
  </main>
  <Footer />
</Layout>

<style is:global>
  .legal-content h1 {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
  }

  .legal-content h2 {
    margin-top: 2rem;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-ink);
  }

  .legal-content p,
  .legal-content li {
    margin-top: 0.75rem;
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  .legal-content ul {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal-content a {
    color: var(--color-burgundy);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-content a:hover {
    color: var(--color-burgundy-dark);
  }

  .legal-meta {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-ink-muted);
  }
</style>
