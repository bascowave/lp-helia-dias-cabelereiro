---
import { Image } from 'astro:assets';
import { brands } from '../data/site';
import SectionHeading from './SectionHeading.astro';
import { imageSizes, imageWidths } from '../lib/imageSizes';
import kerastaseLogo from '../assets/images/marca-kerastase.png';
import wellaLogo from '../assets/images/marca-wella-professionals.png';

const logos = {
  kerastase: kerastaseLogo,
  wella: wellaLogo,
} as const;
---

<section id="marcas" class="section-padding scroll-mt-24 bg-ivory-dark">
  <div class="container-wide">
    <SectionHeading
      label={brands.label}
      title={brands.title}
      description={brands.description}
      align="center"
      class="max-w-2xl"
    />

    <ul
      class="mx-auto mt-14 grid max-w-4xl gap-10 sm:grid-cols-2 sm:gap-16"
      aria-label="Marcas profissionais utilizadas no salão"
    >
      {
        brands.items.map((brand) => (
          <li class="flex flex-col items-center text-center">
            <div
              class="flex w-full min-h-[6rem] items-center justify-center px-4 sm:min-h-[7rem]"
            >
              <Image
                src={logos[brand.image]}
                alt={brand.alt}
                widths={[...imageWidths.brandLogo]}
                sizes={imageSizes.brandLogo}
                class:list={[
                  'w-auto max-w-full object-contain',
                  brand.image === 'kerastase'
                    ? 'h-[3.25rem] sm:h-[3.75rem] md:h-20'
                    : 'h-16 sm:h-[4.5rem]',
                ]}
              />
            </div>
            <p class="sr-only">{brand.name}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
