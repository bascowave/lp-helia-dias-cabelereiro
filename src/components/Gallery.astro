---
import { Image } from 'astro:assets';
import { galleryItems, site } from '../data/site';
import imagem1 from '../assets/images/imagem1.png';
import galeriaPenteado from '../assets/images/galeria-penteado.jpg';
import imagem3 from '../assets/images/imagem3.png';
import imagem4 from '../assets/images/imagem4.png';
import imagem5 from '../assets/images/imagem5.png';
import galeriaPenteadoPerolas from '../assets/images/galeria-penteado-perolas.jpg';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { imageSizes, imageWidths } from '../lib/imageSizes';

const images = {
  imagem1,
  galeriaPenteado,
  imagem3,
  imagem4,
  imagem5,
  galeriaPenteadoPerolas,
} as const;
---

<section id="galeria" class="section-padding">
  <div class="container-wide">
    <SectionHeading
      label="O nosso trabalho"
      title="Resultados que falam por si"
      description="Cortes, cores e transformações criadas diariamente no nosso salão."
    />

    <div class="mx-auto mt-10 grid max-w-4xl grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 md:gap-5">
      {
        galleryItems.map((item) => (
          <figure class="group aspect-[4/5] overflow-hidden rounded-sm bg-ivory-dark">
            <Image
              src={images[item.image]}
              alt={item.alt}
              widths={[...imageWidths.gallery]}
              sizes={imageSizes.gallery}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
              style={item.objectPosition ? `object-position: ${item.objectPosition}` : undefined}
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-8 text-center">
      <Button href={site.links.instagram} external variant="secondary">
        Ver mais no Instagram
      </Button>
    </div>
  </div>
</section>
