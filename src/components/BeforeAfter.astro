---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeAlt: string;
  afterAlt: string;
  caption?: string;
}

const { before, after, beforeAlt, afterAlt, caption = 'Balayage' } = Astro.props;
---

<figure class="ba-widget">
  <div class="ba-stage" data-before-after>
    <div class="ba-media" data-ba-media style="--split: 52%">
      <Image
        src={after}
        alt={afterAlt}
        widths={[640, 960, 1280]}
        sizes="(max-width: 1024px) 92vw, 560px"
        class="ba-img ba-img-after"
        draggable="false"
      />
      <Image
        src={before}
        alt={beforeAlt}
        widths={[640, 960, 1280]}
        sizes="(max-width: 1024px) 92vw, 560px"
        class="ba-img ba-img-before"
        draggable="false"
      />

      <div class="ba-handle" data-ba-handle aria-hidden="true">
        <span class="ba-line"></span>
        <span class="ba-knob">
          <svg class="ba-chevron" viewBox="0 0 8 14" fill="none" aria-hidden="true">
            <path d="M7 1 1 7l6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <svg class="ba-chevron" viewBox="0 0 8 14" fill="none" aria-hidden="true">
            <path d="m1 1 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
      </div>

      <span class="ba-label ba-label-before">Antes</span>
      <span class="ba-label ba-label-after">Depois</span>

      <input
        class="ba-range"
        data-ba-range
        type="range"
        min="2"
        max="98"
        value="52"
        aria-label="Comparar antes e depois"
      />
    </div>

    <figcaption class="ba-bar">
      <span class="ba-bar-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <circle cx="12" cy="12" r="3.2"></circle>
          <path stroke-linecap="round" d="M4.6 8.2 6 6.4h3.1L10.4 5h3.2L15 6.4h3.1l1.3 1.8"></path>
          <rect x="3.5" y="8.2" width="17" height="11.3" rx="2.2"></rect>
        </svg>
      </span>
      <span class="ba-bar-title">{caption}</span>
      <span class="ba-bar-hint">Arraste para comparar</span>
    </figcaption>
  </div>
</figure>

<style>
  @property --split {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 52%;
  }

  .ba-widget {
    margin: 0;
    width: 100%;
  }

  .ba-stage {
    overflow: hidden;
    border-radius: 1rem;
    background: #1c1614;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.06) inset,
      0 24px 48px -20px rgb(28 22 20 / 0.55);
  }

  .ba-media {
    --split: 52%;
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    cursor: ew-resize;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }

  .ba-media :global(.ba-img) {
    position: absolute;
    inset: 0;
    display: block;
    height: 100%;
    width: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center 22%;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .ba-media :global(.ba-img-before) {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }

  .ba-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--split);
    z-index: 2;
    display: flex;
    width: 3px;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .ba-line {
    display: block;
    width: 2px;
    height: 100%;
    margin: 0 auto;
    background: rgb(255 255 255 / 0.95);
    box-shadow: 0 0 12px rgb(0 0 0 / 0.28);
  }

  .ba-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    height: 2.5rem;
    width: 2.5rem;
    align-items: center;
    justify-content: center;
    gap: 0.15rem;
    border-radius: 999px;
    background: #fff;
    color: #1c1614;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 8px 20px rgb(0 0 0 / 0.22);
    transform: translate(-50%, -50%);
    transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .ba-media.is-dragging .ba-knob {
    transform: translate(-50%, -50%) scale(0.97);
  }

  .ba-chevron {
    width: 0.55rem;
    height: 0.85rem;
  }

  .ba-label {
    position: absolute;
    bottom: 0.85rem;
    z-index: 3;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgb(28 22 20 / 0.55);
    color: #f6f1e8;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
    pointer-events: none;
    transition: opacity 160ms ease;
  }

  .ba-label-before {
    left: 0.85rem;
  }

  .ba-label-after {
    right: 0.85rem;
  }

  .ba-range {
    position: absolute;
    inset: 0;
    z-index: 4;
    margin: 0;
    width: 100%;
    height: 100%;
    cursor: ew-resize;
    opacity: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    touch-action: none;
  }

  .ba-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 2.75rem;
    height: 100%;
    background: transparent;
    cursor: ew-resize;
  }

  .ba-range::-moz-range-thumb {
    width: 2.75rem;
    height: 100%;
    border: 0;
    background: transparent;
    cursor: ew-resize;
  }

  .ba-range::-moz-range-track {
    background: transparent;
  }

  .ba-bar {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.9rem 0.8rem;
    color: rgb(246 241 232 / 0.72);
  }

  .ba-bar-icon {
    display: flex;
    height: 1.75rem;
    width: 1.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.35rem;
    background: rgb(246 241 232 / 0.08);
  }

  .ba-bar-icon svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .ba-bar-title {
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: rgb(246 241 232 / 0.88);
  }

  .ba-bar-hint {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(246 241 232 / 0.45);
  }

  .ba-media.is-hint {
    animation: ba-peek 1.8s cubic-bezier(0.77, 0, 0.175, 1) 0.5s both;
  }

  @keyframes ba-peek {
    0%,
    100% {
      --split: 52%;
    }
    40% {
      --split: 70%;
    }
    72% {
      --split: 44%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ba-media.is-hint {
      animation: none;
    }

    .ba-knob {
      transition: none;
    }
  }

  @media (max-width: 639px) {
    .ba-bar-hint {
      display: none;
    }
  }
</style>

<script>
  function initBeforeAfter(root: HTMLElement) {
    const media = root.querySelector<HTMLElement>('[data-ba-media]');
    const range = root.querySelector<HTMLInputElement>('[data-ba-range]');
    const beforeLabel = root.querySelector<HTMLElement>('.ba-label-before');
    const afterLabel = root.querySelector<HTMLElement>('.ba-label-after');
    if (!media || !range) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reducedMotion) media.classList.add('is-hint');

    const setSplit = (percent: number) => {
      const value = Math.min(98, Math.max(2, percent));
      media.style.setProperty('--split', `${value}%`);
      range.value = String(Math.round(value));
      if (beforeLabel) beforeLabel.style.opacity = value < 14 ? '0' : '1';
      if (afterLabel) afterLabel.style.opacity = value > 86 ? '0' : '1';
    };

    const stopHint = () => {
      if (!media.classList.contains('is-hint')) return;
      const computed = getComputedStyle(media).getPropertyValue('--split').trim();
      media.classList.remove('is-hint');
      media.style.setProperty('--split', computed || '52%');
    };

    range.addEventListener('pointerdown', () => {
      stopHint();
      media.classList.add('is-dragging');
    });

    range.addEventListener('pointerup', () => media.classList.remove('is-dragging'));
    range.addEventListener('pointercancel', () => media.classList.remove('is-dragging'));

    range.addEventListener('input', () => {
      stopHint();
      setSplit(Number(range.value));
    });

    range.addEventListener('keydown', () => stopHint());
  }

  document.querySelectorAll<HTMLElement>('[data-before-after]').forEach(initBeforeAfter);
</script>
