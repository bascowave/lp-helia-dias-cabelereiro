---
import { imgSrc } from '../../lib/server/images.ts';
interface Props { name: string; label: string; value: string; imagens: { arquivo: string; alt: string }[] }
const { name, label, value, imagens } = Astro.props;
---
<fieldset class="image-field space-y-3 rounded-sm border border-ink/10 bg-white/50 p-3">
  <legend class="px-1 text-sm font-medium">{label}</legend>
  <div class="flex items-start gap-4">
    <div class="flex h-28 w-40 shrink-0 items-center justify-center overflow-hidden rounded-sm border border-ink/10 bg-ivory-dark text-xs text-ink-muted">
      {value ? <img data-preview src={imgSrc(value, 800)} alt="" class="h-full w-full object-cover" /> : <img data-preview alt="" class="hidden h-full w-full object-cover" />}
      {!value && <span data-vazio>Sem imagem</span>}
    </div>
    <div class="min-w-0 flex-1 space-y-3">
      <label class="block text-sm">Enviar do computador <span class="text-xs text-ink-muted">(JPG, PNG ou WebP, máx. 10 MB)</span>
        <input type="file" data-file name={`${name}__file`} accept="image/jpeg,image/png,image/webp" class="mt-1 block w-full text-sm file:mr-3 file:cursor-pointer file:rounded-sm file:border-0 file:bg-burgundy file:px-3 file:py-1.5 file:text-ivory" />
      </label>
      <label class="block text-xs text-ink-muted">ou escolher uma já enviada
        <select name={name} class="mt-1 w-full rounded-sm border border-ink/20 px-2 py-1.5 text-sm text-ink">
          <option value="">— sem imagem —</option>
          {imagens.map((i) => <option value={i.arquivo} selected={i.arquivo === value}>{i.alt || i.arquivo}</option>)}
        </select>
      </label>
    </div>
  </div>
</fieldset>

<script>
  document.querySelectorAll<HTMLFieldSetElement>('.image-field:not([data-pronto])').forEach((f) => {
    f.dataset.pronto = '1';
    const file = f.querySelector<HTMLInputElement>('[data-file]')!;
    const img = f.querySelector<HTMLImageElement>('[data-preview]')!;
    file.addEventListener('change', () => {
      const novo = file.files?.[0];
      if (!novo) return;
      img.src = URL.createObjectURL(novo);
      img.classList.remove('hidden');
      f.querySelector('[data-vazio]')?.remove();
    });
  });
</script>
