---
interface Props {
  author: string;
  avatar: string | null;
}

const { author, avatar } = Astro.props;

const parts = author.trim().split(/\s+/);
const initials =
  parts.length >= 2
    ? `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase()
    : author.slice(0, 2).toUpperCase();

const hue = [...author].reduce((acc, char) => acc + char.charCodeAt(0), 0) % 360;
---

{
  avatar ? (
    <img
      src={avatar}
      alt={`Foto de perfil de ${author}`}
      width="40"
      height="40"
      class="h-10 w-10 shrink-0 rounded-full object-cover ring-1 ring-ink/10"
      loading="lazy"
      decoding="async"
    />
  ) : (
    <span
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white ring-1 ring-ink/10"
      style={`background-color: hsl(${hue} 45% 42%)`}
      aria-hidden="true"
    >
      {initials}
    </span>
  )
}
