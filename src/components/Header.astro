---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import logo from '../assets/images/logo.jpg';
---

<header class="fixed top-0 z-50 w-full">
  <input type="checkbox" id="nav-toggle" class="peer sr-only" aria-hidden="true" />

  <div
    class="nav-bar border-b border-ivory/10 bg-ink/35 backdrop-blur-md transition-colors duration-300"
  >
    <div class="container-wide flex items-center justify-between px-5 py-4 md:px-8 lg:px-12">
      <a href="/" class="flex shrink-0 items-center gap-3" aria-label={site.name}>
        <Image
          src={logo}
          alt={site.name}
          width={56}
          height={56}
          class="h-11 w-11 rounded-full object-cover ring-1 ring-ivory/20 md:h-12 md:w-12"
        />
        <span
          class="hidden font-serif text-lg leading-none tracking-tight text-ivory sm:block md:text-xl"
        >
          Hélia Dias
        </span>
      </a>

      <div class="flex items-center gap-6">
        <nav class="hidden items-center gap-8 lg:flex" aria-label="Principal">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="text-sm tracking-wide text-ivory/85 transition-colors hover:text-ivory"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <label
          for="nav-toggle"
          class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-sm border border-ivory/20 lg:hidden"
          aria-label="Abrir menu"
        >
          <svg
            class="menu-icon-open h-5 w-5 text-ivory"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="menu-icon-close hidden h-5 w-5 text-ivory"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </label>
      </div>
    </div>
  </div>

  <label
    for="nav-toggle"
    class="mobile-nav-backdrop pointer-events-none fixed inset-0 z-40 bg-ink/40 opacity-0 transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  ></label>

  <div
    class="mobile-nav-panel pointer-events-none fixed right-0 top-0 z-50 flex h-full w-[min(100%,20rem)] flex-col bg-ivory px-6 py-8 opacity-0 shadow-2xl transition-opacity duration-300 lg:hidden"
  >
    <div class="mb-8 flex items-center justify-between">
      <span class="font-serif text-xl text-ink">Menu</span>
      <label for="nav-toggle" class="cursor-pointer p-2" aria-label="Fechar menu">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </label>
    </div>

    <nav class="flex flex-col gap-5" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-lg tracking-wide text-ink transition-colors hover:text-burgundy"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="mt-auto pt-10">
      <a
        href={site.phoneHref}
        class="block text-center text-sm tracking-wide text-ink-muted transition-colors hover:text-burgundy"
      >
        {site.phone}
      </a>
    </div>
  </div>
</header>

<style>
  #nav-toggle:checked ~ .mobile-nav-panel {
    opacity: 1;
    pointer-events: auto;
  }

  #nav-toggle:checked ~ .mobile-nav-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  #nav-toggle:checked + .nav-bar .menu-icon-open {
    display: none;
  }

  #nav-toggle:checked + .nav-bar .menu-icon-close {
    display: block;
  }
</style>
